module acceptance::bounded_group_input_max_v1

resource Token has store, consume {
    amount: u64
}

action verify(input inputs: BoundedCellSet<Token, 1024>) -> u64 {
    verification
        let mut total: u64 = 0
        consume_each token in inputs {
            require token.amount == 1
            total += token.amount
        }
        require total <= 1024
        return 0
}
