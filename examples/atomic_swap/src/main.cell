module cellscript::atomic_swap

use cellscript::fungible_token::Token

// HTLC-style atomic swap: a participant locks an asset behind a hashlock +
// timelock, then either the counterparty claims it by revealing a preimage,
// or the original owner refunds it once the timeout expires. This example
// exercises consume/create/destroy, witness binding, hash commitments, and
// time-point guards across a multi-action business flow.

const U64_MAX: u64 = 18446744073709551615

const REFUND_LOCK_PERIOD: u64 = 100

enum SwapState {
    Pending,
    Claimed,
    Refunded,
}

resource SwapLock has store, create, consume, replace, burn, read_ref {
    swap_id: Hash,
    initiator: Address,
    participant: Address,
    hashlock: Hash,
    timeout_timepoint: u64,
    token_symbol: [u8; 8],
    amount: u64,
    state: SwapState,
}

receipt PreimageClaim has create, consume, burn {
    swap_id: Hash,
    preimage: Hash,
    claimed_by: Address,
    claimed_at: u64,
}

receipt RefundClaim has create, consume, burn {
    swap_id: Hash,
    refunded_by: Address,
    refunded_at: u64,
}

flow SwapLock.state {
    initial Pending;
    terminal Claimed, Refunded;

    Pending -> Claimed;
    Pending -> Refunded;
}

action initiate_swap(
    swap_id: Hash,
    initiator: Address,
    participant: Address,
    hashlock: Hash,
    timeout_timepoint: u64,
    token: Token,
) -> swap_lock: SwapLock {
    verification
        let current_epoch = ckb::header_dep(0).epoch_number
        let now = ckb::epoch_number_to_u64(current_epoch)
        let current_since = ckb::since_absolute_epoch(now, 0, 1)
        let timeout_since = ckb::since_absolute_epoch(timeout_timepoint, 0, 1)
        require token.amount > 0, "zero amount"
        require timeout_since > current_since, "timeout is not in the future"
        require timeout_timepoint <= U64_MAX - REFUND_LOCK_PERIOD, "refund timeout overflow"
        consume token
        create swap_lock = SwapLock { swap_id, initiator, participant, hashlock, timeout_timepoint, token_symbol: token.symbol, amount: token.amount, state: SwapState::Pending } with_lock(initiator)

}

action claim_with_preimage(
    lock: SwapLock,
    preimage: Hash,
    claimed_by: Address,
) -> (released_token: Token, claim: PreimageClaim, updated_lock: SwapLock) {
    transition lock.state: Pending -> updated_lock.state: Claimed
    verification
        let now = ckb::epoch_number_to_u64(ckb::header_dep(0).epoch_number)
        require claimed_by == lock.participant, "not the participant"
        require now < lock.timeout_timepoint, "claim window expired"
        require hash_blake2b(preimage) == lock.hashlock, "wrong preimage"
        require lock.state == SwapState::Pending, "not pending"
        preserve updated_lock from lock {
            swap_id
            initiator
            participant
            hashlock
            timeout_timepoint
            token_symbol
            amount
        }
        consume lock
        create released_token = Token { amount: lock.amount, symbol: lock.token_symbol } with_lock(lock.participant)
        create claim = PreimageClaim { swap_id: lock.swap_id, preimage, claimed_by, claimed_at: now }
        create updated_lock = SwapLock { swap_id: lock.swap_id, initiator: lock.initiator, participant: lock.participant, hashlock: lock.hashlock, timeout_timepoint: lock.timeout_timepoint, token_symbol: lock.token_symbol, amount: lock.amount, state: SwapState::Claimed } with_lock(lock.initiator)

}

action refund_after_timeout(
    lock: SwapLock,
    refunded_by: Address,
) -> (released_token: Token, refund: RefundClaim, updated_lock: SwapLock) {
    transition lock.state: Pending -> updated_lock.state: Refunded
    verification
        let now = ckb::epoch_number_to_u64(ckb::header_dep(0).epoch_number)
        let refund_delay = ckb::since_relative_epoch(REFUND_LOCK_PERIOD, 0, 1)
        require ckb::since_to_raw(refund_delay) > 0
        require refunded_by == lock.initiator, "not the initiator"
        require now >= lock.timeout_timepoint + REFUND_LOCK_PERIOD, "timeout not reached"
        require lock.state == SwapState::Pending, "not pending"
        preserve updated_lock from lock {
            swap_id
            participant
            hashlock
            timeout_timepoint
            token_symbol
            amount
        }
        consume lock
        create released_token = Token { amount: lock.amount, symbol: lock.token_symbol } with_lock(lock.initiator)
        create refund = RefundClaim { swap_id: lock.swap_id, refunded_by, refunded_at: now }
        create updated_lock = SwapLock { swap_id: lock.swap_id, initiator: lock.initiator, participant: lock.participant, hashlock: lock.hashlock, timeout_timepoint: lock.timeout_timepoint, token_symbol: lock.token_symbol, amount: lock.amount, state: SwapState::Refunded } with_lock(refunded_by)

}

fn is_swap_pending(lock: &SwapLock) -> bool {
    lock.state == SwapState::Pending
}

lock swap_admin(protected lock: SwapLock, witness claimed_admin: Address) -> bool {
    verification
        require claimed_admin == lock.initiator
}
