module cellscript::language::verification::transaction_views

resource AuditedCell has store {
    amount: u64,
}

action inspect_transaction() -> u64 {
    verification
        let input = ckb::input<AuditedCell>(0)
        let output = ckb::output<AuditedCell>(0)
        let dep = ckb::cell_dep(0)
        let witness_args = witness::args(0)
        let out_point = input.out_point
        let lock = input.lock
        let transaction_hash = ckb::transaction_hash()
        require lock.args_empty || lock.hash_type <= 4
        require transaction_hash != Hash::zero()
        return input.capacity + output.output_index + dep.data_size + witness_args.size + out_point.index
}
