module examples::language::ckb::sighash_all_zero_lock

action inspect() -> u64 {
    verification
        // Bounds: group inputs, all inputs, extra witnesses, bytes per witness.
        let digest = env::sighash_all_zero_lock(4, 8, 4, 4096)
        let expected = witness::args(0).lock
        require Hash::from_sighash_all(digest) == expected
        return 0
}
